{
  "name": "kisi-universe",
  "version": "0.1.0",
  "private": true,
  "description": "The Kisi universe monorepo: kisi.africa (entertainment), kisifarm (business), kisikids (kids), plus the shared character canon.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.5.5"
  }
}
