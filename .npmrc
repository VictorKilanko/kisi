# Flat node_modules (no symlinked virtual store). Chosen because the repo lives on
# a OneDrive-synced Windows path, where pnpm's default symlink/junction layout is
# fragile. This matches the flat layout the app had under npm.
node-linker=hoisted

# Workspace packages are consumed from source via Next's transpilePackages, so we
# do not want pnpm to insist on a published version range for them.
link-workspace-packages=true
