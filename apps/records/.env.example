# Kisi Farm Records — environment variables
# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).

# The public origin of this app (used for auth redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" public key (safe to expose in the browser; Row Level
# Security in the database is what actually protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
